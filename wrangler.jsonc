{
  "name": "microsprouts",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "PAYMENTS_ENABLED": "true",
    "PAYMENT_MODE": "live"
  }
}
